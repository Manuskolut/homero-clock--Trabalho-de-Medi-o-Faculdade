// Schema do banco de dados - Homero Clock Relojóias
// SQLite local (arquivo prisma/dev.db)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Loja {
  id        String   @id // slug fixo: "mueller" | "jockey" | "patio-batel" | "legado"
  nome      String   @unique
  // Telefone de contato exibido na Via do Cliente — editável só por Admin
  // (ver /admin/lojas). Vazio até ser preenchido (ex: loja "legado").
  telefone  String   @default("")
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios Usuario[]
  clientes Cliente[]
  ordens   Ordem[]

  pecasDestino  Peca[]      @relation("PecasDestino")
  pecasVendidas Peca[]      @relation("PecasVenda")
  pecasEventos  PecaEvento[]
}

enum TipoUsuario {
  LOJA
  ADMIN
}

model Usuario {
  id        String      @id @default(cuid())
  email     String      @unique
  nome      String
  senhaHash String
  tipo      TipoUsuario
  // obrigatório quando tipo=LOJA, null quando tipo=ADMIN (validado nas actions, não no schema)
  lojaId    String?
  loja      Loja?       @relation(fields: [lojaId], references: [id])
  ativo     Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([lojaId])
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  telefone  String
  email     String?
  lojaId    String
  loja      Loja     @relation(fields: [lojaId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordens Ordem[]

  @@index([lojaId, nome])
  @@index([lojaId, telefone])
}

enum TipoItem {
  RELOGIO
  JOIA
}

enum StatusOrdem {
  EM_ANALISE
  EM_CONSERTO
  PRONTO_RETIRADA
  SEM_CONSERTO
  ENTREGUE
}

model Ordem {
  id        String @id @default(cuid())
  numeroOS  Int

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id])

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  tipoItem         TipoItem
  descricaoItem    String
  dataEntrada      DateTime
  dataPrevista     DateTime? // opcional no cadastro; exigido ao dar baixa
  valorOrcado      Float? // opcional no cadastro; exigido ao dar baixa
  sinal            Float? // opcional, independente do valorOrcado — valor único por OS inteira
  observacoes      String?

  // Nome (normalmente só o primeiro) de quem atendeu na criação da OS —
  // imutável após criada (não reenviado na edição). Exibido só na Via da
  // Loja. OSs criadas antes deste campo existir ficam com string vazia.
  nomeAtendente String @default("")
  // true quando o atendente digitou a data prometida na criação; false
  // quando ficou em branco e foi calculada automaticamente (+PRAZO_PADRAO_DIAS).
  // Controla o conteúdo do campo "Urgente" na Via da Loja: quando true, a
  // caixa mostra a própria data prometida (em vez do espaço em branco pra
  // anotação manual usado quando o prazo é automático). Recalculado a cada
  // edição da OS. OSs criadas antes deste campo existir ficam com false
  // (mesmo comportamento visual que já tinham: espaço em branco).
  dataPrometidaManual Boolean @default(false)

  // Específico do fluxo Relógio — lista de até 6 relógios, cada um com seus
  // próprios dados técnicos (modelo, tipo, pulseira, estado das peças na entrada)
  relogiosDetalhes Json?
  oficina          String? // oficina destinada (ex: Leandro, Mueller, Jockey, Jorge)

  // Específico do fluxo Joia — lista de peças, cada uma com sua própria
  // descrição, tipo(s) de conserto, tamanho do aro e peso (quando aplicável)
  pecasJoia         Json?

  // Status é sempre definido explicitamente pelo código ao criar/editar a
  // OS (ver criarOrdem/atualizarOrdem) — este default nunca deveria
  // aparecer na prática, é só a obrigação do Prisma de ter um valor válido.
  status              StatusOrdem @default(EM_ANALISE)
  // Momento em que o status virou "Sem conserto" — usado só para o KPI
  // mensal, já que dataRetirada fica nulo enquanto a ordem está aberta
  // (Sem conserto deixou de ser status final; a baixa formal é etapa à parte).
  dataMarcadoSemConserto DateTime?
  dataRetirada        DateTime?
  observacaoRetirada  String?
  cpfRetirada         String? // só dígitos (11), normalizado no Zod — quem retirou o item
  nomeRetirada        String? // nome de quem retirou o item
  emailRetirada       String? // e-mail informado na baixa — independente de Cliente.email
  custoOurives        Float? // custo pago ao ourives (joia) — registrado ao dar baixa

  deletedAt DateTime? // soft delete — só Admin popula este campo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lojaId, numeroOS])
  @@index([lojaId, status])
  @@index([lojaId, dataPrevista])
  @@index([lojaId, dataRetirada])
  @@index([lojaId, dataEntrada])
  @@index([clienteId])
  @@index([numeroOS])
  @@index([tipoItem])
  @@index([deletedAt])
}

enum StatusPeca {
  AGUARDANDO_CONFIRMACAO
  DISPONIVEL
  VENDIDA
}

enum TipoEventoPeca {
  VENDA
  REATIVACAO
}

enum CategoriaPeca {
  JOIA
  FOLHEADO
  RELOGIO
}

model Peca {
  id           String @id @default(cuid())
  nome         String
  descricao    String?
  // Opcional só para Joia (preço pode ser decidido depois) — obrigatório
  // (validado no Zod) para Folheado e Relógio.
  preco        Float?
  // Sequencial global (não por loja — qualquer loja pode dar baixa em
  // qualquer peça), zero-padded, gerado atomicamente (mesmo princípio do
  // numeroOS: transação + retry em colisão). Guardado já formatado porque a
  // leitura é feita por leitor USB (modo teclado) que digita o texto exato.
  codigoBarras String @unique

  categoria CategoriaPeca
  // Só dígitos (validado no Zod), mas guardado como texto — só preenchido
  // quando categoria é RELOGIO. String (não Int) de propósito: permite busca
  // por trecho ("contains") e preserva zeros à esquerda.
  referencia String?
  // Caminho público do arquivo (ex: "/uploads/pecas/<uuid>.jpg") — a imagem
  // em si fica em public/uploads/pecas, fora do SQLite.
  fotoUrl   String?

  lojaDestinoId String
  lojaDestino   Loja   @relation("PecasDestino", fields: [lojaDestinoId], references: [id])

  status StatusPeca

  // Só preenchido quando a loja destino confirma o recebimento (Jockey ou
  // Patio Batel) — peças com destino Mueller nunca passam por esta etapa.
  dataConfirmacao DateTime?

  dataVenda   DateTime?
  lojaVendaId String?
  lojaVenda   Loja?   @relation("PecasVenda", fields: [lojaVendaId], references: [id])

  // Histórico completo de vendas/reativações desta peça — nunca sobrescrito,
  // preservado mesmo após reativar (ver regra de negócio 6: nunca excluir).
  eventos PecaEvento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaDestinoId, status])
  @@index([status])
  @@index([lojaVendaId, status])
  @@index([categoria])
}

model PecaEvento {
  id     String         @id @default(cuid())
  pecaId String
  peca   Peca           @relation(fields: [pecaId], references: [id])
  tipo   TipoEventoPeca
  lojaId String
  loja   Loja           @relation(fields: [lojaId], references: [id])
  data   DateTime       @default(now())

  @@index([pecaId])
}
